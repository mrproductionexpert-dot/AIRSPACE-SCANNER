# Local system Python venv (portable runtime is committed under runtime/python)
.venv/
.venv-linux/
venv/
env/
.pyuser/

# Caches / bytecode (do NOT ignore *.pyd — those are required CPython extensions)
__pycache__/
*.pyc
*.pyo
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
*.log
dist/
build/
*.tmp
*.bak

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Local scan / debug dumps (may contain nearby SSIDs / MACs)
*.pcap
*.pcapng
captures/
logs/
data/
*.csv

# Pip / bootstrap leftovers under runtime (keep the python tree)
runtime/get-pip.py
runtime/python-embed.zip
runtime/python/Lib/site-packages/pip/_internal/commands/wheel/__pycache__/
